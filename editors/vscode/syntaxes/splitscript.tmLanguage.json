{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SplitScript",
  "scopeName": "source.splitscript",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#language"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.splitscript",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.splitscript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.splitscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.signature.splitscript",
          "match": "\\bsig\"(?:\\\\.|[^\"\\\\])*\""
        },
        {
          "name": "constant.numeric.version.splitscript",
          "match": "\\bv\"(?:\\\\.|[^\"\\\\])*\""
        },
        {
          "name": "string.quoted.double.splitscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.splitscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.interpolated.splitscript",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.splitscript",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.splitscript",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(image)\\s+(\"(?:\\\\.|[^\"\\\\])*\")",
          "captures": {
            "1": {
              "name": "keyword.declaration.splitscript"
            },
            "2": {
              "name": "string.quoted.double.splitscript"
            }
          }
        },
        {
          "match": "\\b(namespace)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.splitscript"
            },
            "2": {
              "name": "entity.name.namespace.splitscript"
            }
          }
        },
        {
          "match": "\\b(class|layout)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.splitscript"
            },
            "2": {
              "name": "entity.name.type.splitscript"
            }
          }
        },
        {
          "name": "keyword.declaration.splitscript",
          "match": "\\b(?:static(?=\\s+[A-Za-z_$\\[])|from(?=\\s*(?:\"|\\[)))\\b"
        },
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.splitscript"
            },
            "2": {
              "name": "entity.name.type.splitscript"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+(?:([A-Za-z_$][A-Za-z0-9_$]*)\\.)?([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.splitscript"
            },
            "2": {
              "name": "entity.name.type.splitscript"
            },
            "3": {
              "name": "entity.name.function.splitscript"
            }
          }
        },
        {
          "match": "\\b(let)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.variable.splitscript"
            },
            "2": {
              "name": "variable.other.readwrite.splitscript"
            }
          }
        },
        {
          "match": "=>\\s*([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "variable.other.property.splitscript"
            }
          }
        }
      ]
    },
    "language": {
      "patterns": [
        {
          "name": "keyword.control.splitscript",
          "match": "\\b(if|else|while|loop|for|in|break|continue|match|is|return|throw|inspect|async|iterator|await|retry|yield|as|debug|self)\\b"
        },
        {
          "name": "keyword.declaration.splitscript",
          "match": "\\b(state|settings|struct|enum|fn|let)\\b"
        },
        {
          "name": "keyword.other.lifecycle.splitscript",
          "match": "\\b(setup|selectProcess|onDetach|onAttach|onStateReady|onStart|onReset|whileAttached|start|split|reset|isLoading|gameTime)\\b"
        },
        {
          "name": "storage.type.splitscript",
          "match": "\\b(bool|i8|u8|i16|u16|i32|u32|i64|u64|address|Address|f32|f64|string|String|Duration|Signature|TimerState)\\b"
        },
        {
          "name": "constant.language.splitscript",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.other.enummember.splitscript",
          "match": "\\b(Some|None|Ok|Err)\\b"
        },
        {
          "name": "variable.language.splitscript",
          "match": "\\b(current|old|settings|oldSettings)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.splitscript",
          "match": "\\b0[xX][0-9A-Fa-f_]+(?:i8|u8|i16|u16|i32|u32|i64|u64|address)?\\b"
        },
        {
          "name": "constant.numeric.splitscript",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9_]+)?(?:i8|u8|i16|u16|i32|u32|i64|u64|f32|f64|address)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.accessor.splitscript",
          "match": "\\."
        },
        {
          "name": "keyword.operator.splitscript",
          "match": "\\?\\?|&&|\\|\\||==|!=|<=|>=|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=>|->|[+\\-*/%&|^!~<>=?]"
        }
      ]
    }
  }
}
