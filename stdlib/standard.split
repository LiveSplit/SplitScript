/// Identifies the supported Unity Mono metadata layouts.
///
/// These versions describe Mono's internal target-memory structures, not the
/// marketing version printed by the Mono runtime.
///
/// # Example
///
/// Select a Mono metadata layout
///
/// ```splitscript
/// let monoVersion = MonoVersion.V2
/// ```
@representation(enum, nullable)
@valueUsage(structField, enumPayload, stateField, localVariable, globalVariable)
@capabilities(Equatable)
enum MonoVersion {
    /// Original Unity Mono layout, including the old vtable data slot.
    ///
    /// # Example
    ///
    /// Select the original Mono runtime family
    ///
    /// ```splitscript
    /// state Unity.mono(MonoVersion.V1) ["old-unity-game.exe"] {}
    /// ```
    V1,

    /// Original Mono family with the extended class attribute layout.
    ///
    /// # Example
    ///
    /// Select the extended old Mono runtime family
    ///
    /// ```splitscript
    /// state Unity.mono(MonoVersion.V1Cattrs) ["old-unity-player.exe"] {}
    /// ```
    V1Cattrs,

    /// Layout used by Unity releases before the V3 metadata change.
    ///
    /// # Example
    ///
    /// Discover a V2 runtime
    ///
    /// ```splitscript
    /// state Unity.mono(MonoVersion.V2) ["legacy-unity-game.exe"] {}
    /// ```
    V2,

    /// Layout used by Unity 2021.2 and newer releases.
    ///
    /// # Example
    ///
    /// Discover a V3 runtime
    ///
    /// ```splitscript
    /// state Unity.mono(MonoVersion.V3) ["modern-unity-game.exe"] {}
    /// ```
    V3,
}

/// Stores one validated Unity Mono target-memory layout.
///
/// The owning [`MonoModule`] keeps this descriptor private so every metadata
/// operation consumes the same centralized layout facts.
///
/// # Example
///
/// Use the layout through a discovered runtime
///
/// ```splitscript
/// let layoutBackedRuntime: MonoModule = await Unity.mono(MonoVersion.V2)
/// ```
@representation(gcStruct, nullable)
@valueUsage(structField, localVariable)
private struct MonoLayout {
    /// The runtime family associated with these measured facts.
    private version: MonoVersion,
    /// Assembly-relative name pointer offset, when available.
    private assemblyName: u64?,
    /// Offset of the assembly image pointer.
    private assemblyImage: u64,
    /// Image-relative assembly name pointer offset, when available.
    private imageAssemblyName: u64?,
    /// Offset of the image class-cache hash table.
    private imageClassCache: u64,
    /// Offset of the signed hash-table bucket count.
    private hashSize: u64,
    /// Offset of the bucket array pointer.
    private hashTable: u64,
    /// Offset of the class-kind byte, when measured.
    private classKind: u64?,
    /// Offset of the boxed instance size, when measured.
    private classInstanceSize: u64?,
    /// Offset of the parent class pointer.
    private classParent: u64,
    /// Offset of the declaring class pointer, when measured.
    private classDeclaring: u64?,
    /// Offset of the class name pointer.
    private className: u64,
    /// Offset of the namespace pointer.
    private classNamespace: u64,
    /// Class method-count offset, or old MonoVTable.data offset.
    private classVtableSize: u64,
    /// Offset of the field array pointer.
    private classFields: u64,
    /// Offset of the class runtime-information pointer.
    private classRuntimeInfo: u64,
    /// Offset of the signed field count.
    private classFieldCount: u64,
    /// Offset of the next class in a cache bucket.
    private classNextCache: u64,
    /// Generic-instantiation descriptor offset, when measured.
    private genericClass: u64?,
    /// Generic definition pointer offset, when measured.
    private genericContainer: u64?,
    /// Offset of a MonoType data pointer, when measured.
    private typeData: u64?,
    /// Offset of a MonoType kind byte, when measured.
    private typeKind: u64?,
    /// Field MonoType pointer offset, when measured.
    private fieldType: u64?,
    /// Offset of the field name pointer.
    private fieldName: u64,
    /// Offset of the field value offset.
    private fieldValue: u64,
    /// Byte stride between field metadata entries.
    private fieldStride: u64,
    /// Offset of the modern vtable's method slots.
    private vtable: u64,

