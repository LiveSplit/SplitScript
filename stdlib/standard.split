    /// Target byte offset for `assembly.name`. None means this fact is unavailable.
    ///
    /// # Example
    ///
    /// Inspect a measured layout fact
    ///
    /// ```splitscript
    /// let profile = Il2CppProfile.unity2021_3_11f1X64()
    /// let fact = profile.assemblyName
    /// ```
    assemblyName: u64?,

    /// Target byte offset for `image.assembly_name`. None means this fact is unavailable.
    ///
    /// # Example
    ///
    /// Inspect a measured layout fact
    ///
    /// ```splitscript
    /// let profile = Il2CppProfile.unity2021_3_11f1X64()
    /// let fact = profile.imageAssemblyName
    /// ```
    imageAssemblyName: u64?,

    /// Target byte offset for `image.type_count`.
    ///
    /// # Example
    ///
    /// Inspect a measured layout fact
    ///
    /// ```splitscript
    /// let profile = Il2CppProfile.unity2021_3_11f1X64()
    /// let fact = profile.imageTypeCount
    /// ```
    imageTypeCount: u64,

    /// Location and storage mode of the image's first type index.
    ///
    /// # Example
    ///
    /// Inspect a measured layout fact
    ///
    /// ```splitscript
    /// let profile = Il2CppProfile.unity2021_3_11f1X64()
    /// let fact = profile.imageTypeStart
    /// ```
    imageTypeStart: Il2CppTypeStart,

    /// Target byte offset for `class.name`.
    ///
    /// # Example
    ///
    /// Inspect a measured layout fact
    ///
    /// ```splitscript
    /// let profile = Il2CppProfile.unity2021_3_11f1X64()
    /// let fact = profile.className
    /// ```
    className: u64,

    /// Target byte offset for `class.namespace`.
    ///
    /// # Example
    ///
    /// Inspect a measured layout fact
    ///
    /// ```splitscript
    /// let profile = Il2CppProfile.unity2021_3_11f1X64()
    /// let fact = profile.classNamespace
    /// ```
    classNamespace: u64,

    /// Target byte offset for `class.declaring_type`. None means this fact is unavailable.
