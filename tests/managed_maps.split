image "Assembly-CSharp" {
    class ProfileProbe {
        static Map<String, [String?]> rows;
        static [Map<String, [String?]>?] maps;
        static Map<String, [i32]> wrongNested;
        static Map<String, [[String]]> wrongDepth;
        static Map<[[String?]?], String> arrayKeys;
        static Map<[[i32]?], String> wrongArrayKeys;
        static ProfileProbe instance;
        static Map<[String], [String?]> wrongKeys;
        static Map<String, String> wrongValues;
        Map<String, [String?]> values;
        i32 score;
    }
}
state Unity ["game.exe"] {
    rows = ProfileProbe.rows?;
    maps = ProfileProbe.maps?;
    tree = ProfileProbe.instance?.snapshot()?;
}
whileAttached {
    setVariable("rows", current.rows)
    setVariable("maps", current.maps)
    setVariable("tree", current.tree)
    setVariable("old", old.rows)
    setVariable("result", match ProfileProbe.rows {
        Ok(_) => "ok",
        Err(error) => error,
    })
    let mutation = process.read<i32>(0x6f000) else return
    if mutation == 8 {
        setVariable("wrong", match ProfileProbe.wrongValues { Ok(_) => "ok", Err(error) => error })
    }
    if mutation == 9 {
        setVariable("wrong", match ProfileProbe.wrongKeys { Ok(_) => "ok", Err(error) => error })
    }
    if mutation == 10 { setVariable("wrong", match ProfileProbe.wrongNested { Ok(_) => "ok", Err(error) => error }) }
    if mutation == 11 { setVariable("wrong", match ProfileProbe.wrongDepth { Ok(_) => "ok", Err(error) => error }) }
    if mutation == 12 || mutation == 13 {
        setVariable("arrayKeys", match ProfileProbe.arrayKeys { Ok(_) => "ok", Err(error) => error })
    }
    if mutation == 13 {
        setVariable("wrongArrayKeys", match ProfileProbe.wrongArrayKeys { Ok(_) => "ok", Err(error) => error })
    }
    if mutation == 1 { current.rows.clear() }
    if mutation == 2 { current.rows.insert("seed", []) }
    if mutation == 3 { current.rows.remove("seed") }
    if mutation == 4 { current.rows["seed"] = [] }
    if mutation == 5 { current.rows["seed"].clear() }
    if mutation == 6 { current.tree.values.clear() }
    if mutation == 7 {
        let local = Map.new<String, [String?]>()
        local.insert("local", [Some("okay")])
        setVariable("local", local.length())
    }
}
