image "Assembly-CSharp" {
    class ProfileProbe {
        static String value;
        static ProfileProbe instance;
        String text;
        String? optional;
    }
}
state Unity ["game.exe"] {
    staticText = ProfileProbe.value?;
    liveText = ProfileProbe.instance?.text?;
    snapshot = ProfileProbe.instance?.snapshot()?;
}
whileAttached {
    setVariable("static", current.staticText)
    setVariable("live", current.liveText)
    setVariable("snapshot", current.snapshot.text)
    setVariable("old", old.snapshot.text)
    setVariable("optional", match current.snapshot.optional {
        Some(value) => `some:{value}`,
        None => "none",
    })
    let instance = ProfileProbe.instance else return
    setVariable("result", match instance.snapshot() {
        Ok(_) => "ok",
        Err(error) => error,
    })
}
