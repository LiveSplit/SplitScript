struct ShortRecord { values: [i32; 2], }
struct LongRecord { values: [i32; 6], }
struct Record { values: [i32; 4], }
image "Assembly-CSharp" {
    class ProfileProbe {
        static Set<Record> rows;
        static Set<ShortRecord> shortRows;
        static Set<LongRecord> longRows;
    }
}
state Unity ["game.exe"] { rows = ProfileProbe.rows?; }
whileAttached {
    setVariable("rows", current.rows)
    setVariable("old", old.rows)
    setVariable("result", match ProfileProbe.rows { Ok(_) => "ok", Err(error) => error })
    let mutation = process.read<i32>(0x6f000) else return
    if mutation == 2 { setVariable("wrong", match ProfileProbe.shortRows { Ok(_) => "ok", Err(error) => error }) }
    if mutation == 3 { setVariable("wrong", match ProfileProbe.longRows { Ok(_) => "ok", Err(error) => error }) }
    if mutation == 1 { for row in current.rows { row.values[0] = 99 } }
}
