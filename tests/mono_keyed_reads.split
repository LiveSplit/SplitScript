// Compiler-owned private adapter probe; compiled by managed_collection_layout_tests.
state "game.exe" {}
onAttach { await __splitscript_stdlib_collection_probe() }
fn __splitscript_stdlib_collection_probe() {
    let version = match process.read<u8>(0x6000a) else 0 {
        1 => MonoVersion.V1Cattrs,
        3 => MonoVersion.V3,
        _ => MonoVersion.V2,
    }
    let runtime = await Unity.mono(version)
    let missing = process.read<u8>(0x60009) else 0
    while true {
        let object = (process.read<u64>(0x60000) else 0) as address
        let dictionary = (process.read<u8>(0x60008) else 0) == 0
        let result = if missing != 0 {
            runtime.keyedLayout(object, () => true, (fields, class, types, count) => {
                let altered = UnityCollectionTypes { names: types.names, mono: types.mono, charge: types.charge, genericSize: types.genericSize, plainClass: types.plainClass,
                    data: if missing == 2 { None } else { types.data },
                    kindOffset: if missing == 1 { None } else { types.kindOffset },
                    cached: if missing == 5 { None } else { types.cached },
                    instanceSize: if missing == 4 { None } else { types.instanceSize },
                    fieldType: if missing == 3 { None } else { types.fieldType } }
                if dictionary { fields.dictionaryLayout(class, altered, count) }
                    else { fields.setLayout(class, altered, count) }
            })
        }
            else if dictionary { runtime.dictionaryLayout(object, () => true) } else { runtime.setLayout(object, () => true) }
        match result {
            Ok(layout) => {
                let keyBytes = process.read<u32>(0x60010) else 0
                let valueBytes = process.read<u32>(0x60014) else 0
                let scanBudget = process.read<u32>(0x60018) else 0
                let elementBudget = process.read<u32>(0x6001c) else 0
                let byteBudget = process.read<u64>(0x60020) else 0
                let keyKinds = process.read<u32>(0x60028) else 0
                let valueKinds = process.read<u32>(0x6002c) else 0
                let arrayType: (address, address) -> address! = (array, declared) => match runtime.objectClass(array, () => true) {
                    Ok(class) => match runtime.verifyArrayType(class, declared, () => true) {
                        Ok(_) => Ok(class),
                        Err(error) => Err(error),
                    },
                    Err(error) => Err(error),
                }
                match layout.readSlots(object, keyBytes, valueBytes, keyKinds, valueKinds, scanBudget, elementBudget, byteBudget, arrayType) {
                    Ok(read) => {
                        process.read<u8>(0x60040)
                        match read.verify() {
                            Ok(_) => {
                                let keys: [address] = []
                                let values: [address] = []
                                for slot in read.slots { keys.push(slot.key); values.push(slot.value) }
                                setVariable("keys", keys)
                                setVariable("values", values)
                                setVariable("scanned", read.scanned)
                                setVariable("bytes", read.bytes)
                                setVariable("result", "ok")
                            },
                            Err(error) => setVariable("result", error),
                        }
                    },
                    Err(error) => setVariable("result", error),
                }
            },
            Err(error) => setVariable("result", error),
        }
        await nextTick()
    }
}
