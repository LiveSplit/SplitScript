image "Assembly-CSharp" {
    class ProfileProbe {
        static ProfileProbe instance;
        static [String] strings;
        [[String?]?] nested;
        [Leaf?] leaves;
        [i32] numbers;
        [address] pointers;
        [[i32; 2]] pairs;
    }
    class Leaf { String text; }
}
state Unity ["game.exe"] {
    strings = ProfileProbe.strings?;
    snapshot = ProfileProbe.instance?.snapshot()?;
}
whileAttached {
    setVariable("strings", current.strings)
    setVariable("nested", current.snapshot.nested)
    setVariable("leaves", current.snapshot.leaves)
    setVariable("numbers", current.snapshot.numbers)
    setVariable("pointers", current.snapshot.pointers)
    setVariable("pairs", current.snapshot.pairs)
    setVariable("old", old.snapshot.nested)
    let root = ProfileProbe.instance else return
    setVariable("result", match root.snapshot() {
        Ok(_) => "ok",
        Err(error) => error,
    })
}
