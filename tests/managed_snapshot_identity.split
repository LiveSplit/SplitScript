image "Assembly-CSharp" {
    class ProfileProbe { static ProfileProbe instance; i32 value; }
    class Empty from "ProfileProbe" { static Empty instance; }
}
state Unity ["game.exe"] {
    snapshot = ProfileProbe.instance?.snapshot()?;
    _empty = Empty.instance?.snapshot()?;
}
whileAttached {
    setVariable("value", current.snapshot.value)
    setVariable("old", old.snapshot.value)
    let root = ProfileProbe.instance else return
    let empty = Empty.instance else return
    setVariable("result", match root.snapshot() { Ok(_) => "ok", Err(error) => error })
    setVariable("empty", match empty.snapshot() { Ok(_) => "ok", Err(error) => error })
}
