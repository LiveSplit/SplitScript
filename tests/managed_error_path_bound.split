image "Assembly-CSharp" {
    class ProfileProbe {
        static ProfileProbe instance;
        ProfileProbe? left_context_context_context_context_context_context_context_context_context_context_context_context_context_context_context_context_ from "left";
        ProfileProbe? right;
        String text;
    }
}
fn count(value: ProfileProbe) -> u32 {
    let left_context_context_context_context_context_context_context_context_context_context_context_context_context_context_context_context_ = match value.left_context_context_context_context_context_context_context_context_context_context_context_context_context_context_context_context_ { Some(child) => count(child), None => 0 }
    let right = match value.right { Some(child) => count(child), None => 0 }
    return 1 + left_context_context_context_context_context_context_context_context_context_context_context_context_context_context_context_context_ + right
}
state Unity ["game.exe"] { tree = ProfileProbe.instance?.snapshot()?; }
whileAttached {
    setVariable("count", count(current.tree))
    setVariable("old", count(old.tree))
    setVariable("text", current.tree.text)
    let root = ProfileProbe.instance else return
    setVariable("result", match root.snapshot() {
        Ok(_) => "ok",
        Err(error) => error,
    })
}
