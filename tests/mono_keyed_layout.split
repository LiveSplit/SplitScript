// Compiler-owned private adapter probe; compiled by managed_collection_layout_tests.
state "game.exe" {}
onAttach { await __splitscript_stdlib_collection_probe() }
fn __splitscript_stdlib_collection_probe() {
    let version = match process.read<u8>(0x6000a) else 0 {
        1 => MonoVersion.V1Cattrs,
        3 => MonoVersion.V3,
        _ => MonoVersion.V2,
    }
    let runtime = await Unity.mono(version)
    let missing = process.read<u8>(0x60009) else 0
    while true {
        let object = (process.read<u64>(0x60000) else 0) as address
        let dictionary = (process.read<u8>(0x60008) else 0) == 0
        let result = if missing != 0 {
            runtime.keyedLayout(object, () => true, (fields, class, types, count) => {
                let altered = UnityCollectionTypes { names: types.names, mono: types.mono, charge: types.charge, genericSize: types.genericSize,
                    data: if missing == 2 { None } else { types.data },
                    kindOffset: if missing == 1 { None } else { types.kindOffset },
                    cached: if missing == 5 { None } else { types.cached },
                    instanceSize: if missing == 4 { None } else { types.instanceSize },
                    fieldType: if missing == 3 { None } else { types.fieldType } }
                if dictionary { fields.dictionaryLayout(class, altered, count) }
                    else { fields.setLayout(class, altered, count) }
            })
        }
            else if dictionary { runtime.dictionaryLayout(object, () => true) } else { runtime.setLayout(object, () => true) }
        match result {
            Ok(layout) => {
                setVariable("class", layout.runtimeClass)
                setVariable("owner", layout.declaringClass)
                setVariable("parallel", layout.parallel)
                setVariable("stride", layout.stride)
                let offsets: [u32] = []
                for field in layout.fields { offsets.push(field.offset) }
                setVariable("fields", offsets)
                let members: [u32] = []
                let types: [address] = []
                for member in layout.members { members.push(member.offset); types.push(member.typeAddress) }
                setVariable("members", members)
                setVariable("types", types)
                setVariable("result", "ok")
            },
            Err(error) => setVariable("result", error),
        }
        await nextTick()
    }
}
